{
  "name": "wa-hook",
  "version": "0.1.0",
  "description": "Local WhatsApp Cloud API simulator and webhook handler",
  "main": "dist/index.js",
  "bin": {
    "wa-hook": "dist/bin/cli.js"
  },
  "scripts": {
    "build": "tsc && copyfiles -u 0 \"public/**/*\" \"public/*\" dist/",
    "start": "node dist/bin/cli.js",
    "dev": "tsx watch src/index.ts"
  },
  "keywords": ["whatsapp", "api", "simulator", "webhook", "testing", "cli"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "copyfiles": "^2.4.1",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
